generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  ABANDONED
  COMPLETED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  password      String
  shopName      String?
  subdomain     String?   @unique
  role          Role      @default(USER)
  active        Boolean   @default(true)
  isPremium     Boolean   @default(false)
  templateId    String    @default("basic")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Multi-tenant relations
  products      Product[]
  orders        Order[]
  leads         Lead[]
  settings      Settings?
  landingPages  LandingPage[]
  sentMessages  Message[] @relation("SentMessages")
  googleSheetId String?
}

model GlobalSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  defaultDelivery Float    @default(7)
  freeShippingMin Float    @default(150)
  maintenanceMode Boolean  @default(false)
  announcement    String?
  updatedAt       DateTime @updatedAt
}

model Message {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  senderId    String   @db.ObjectId
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String?  @db.ObjectId // If null and isAdmin is true, it might still mean broadcast (optional)
  isAdmin     Boolean  @default(false) // If true, it's a message from Admin to a Shop
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  comparePrice Float?
  image       String?
  stock       Int      @default(0)
  active      Boolean  @default(true)
  offers      Json?    // Array of { text: string, price: number, active: boolean }
  freeShipping Boolean @default(false)
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  landingPages LandingPage[]
  createdAt   DateTime @default(now())
}

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  customerName    String
  customerPhone   String
  customerAddress String
  customerCity    String?
  total           Float
  deliveryFee     Float
  productName     String?
  items           Json?
  status          OrderStatus @default(COMPLETED)
  userId          String      @db.ObjectId
  user            User        @relation(fields: [userId], references: [id])
  leadId          String?     @db.ObjectId
  createdAt       DateTime    @default(now())
}

model Lead {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  customerName    String?
  customerPhone   String?
  customerAddress String?
  customerCity    String?
  productName     String?
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  recovered       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Settings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  storeName       String?
  logo            String?
  banner          String?
  primaryColor    String   @default("#000000")
  secondaryColor  String   @default("#ffffff")
  bannerText      String?
  freeShippingMin Float    @default(150)
  fixedDelivery   Float    @default(7)
  tiktokPixel     String?
  facebookPixel   String?
  whatsappAssistantEnabled Boolean @default(false)
  arabicFont      String   @default("Tajawal")
  userId          String   @unique @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
}

model LandingPage {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  content       Json     // For dynamic components like video, gallery, CTAs
  productId     String?  @db.ObjectId
  product       Product? @relation(fields: [productId], references: [id])
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  active        Boolean  @default(true)
  isSuspended   Boolean  @default(false)
  createdAt     DateTime @default(now())
}
